def mask_ip_address(address):
    ip = ipaddress.ip_address(address)

    if ip.version == 4:
        # Preserve the network portion and hide the host portion.
        network = ipaddress.IPv4Network(f"{ip}/24", strict=False)
        return f"{network.network_address}/24"

    # Show only the IPv6 prefix.
    network = ipaddress.IPv6Network(f"{ip}/64", strict=False)
    return f"{network.network_address}/64"


def print_packet(packet):
    timestamp = datetime.now().strftime("%H:%M:%S")

    if packet.haslayer(IP):
        ip_layer = packet[IP]
        version = "IPv4"
        source = mask_ip_address(ip_layer.src)
        destination = mask_ip_address(ip_layer.dst)
        protocol = ip_layer.proto
    elif packet.haslayer(IPv6):
        ip_layer = packet[IPv6]
        version = "IPv6"
        source = mask_ip_address(ip_layer.src)
        destination = mask_ip_address(ip_layer.dst)
        protocol = ip_layer.nh
    else:
        return

    if packet.haslayer(TCP):
        transport = f"TCP {packet[TCP].sport} -> {packet[TCP].dport}"
    elif packet.haslayer(UDP):
        transport = f"UDP {packet[UDP].sport} -> {packet[UDP].dport}"
    else:
        transport = f"IP protocol {protocol}"

    print(
        f"[{timestamp}] "
        f"{version} "
        f"{source} -> {destination} | {transport}"
    )
